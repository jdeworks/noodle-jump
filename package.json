{
  "name": "noodle-jump",
  "version": "1.0.0",
  "license": "MIT",
  "description": "A pasta-themed endless jumper built with PixiJS and TypeScript",
  "author": "jdeworks",
  "homepage": "https://jdeworks.github.io/noodle-jump/",
  "repository": "github:jdeworks/noodle-jump",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest run",
    "format": "prettier --write .",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@trystero-p2p/nostr": "^0.23.0",
    "pako": "^2.1.0",
    "pixi.js": "^8.6.6"
  },
  "devDependencies": {
    "@types/pako": "^2.0.4",
    "eslint": "^9.24.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.58.0",
    "vite": "^6.3.1",
    "vitest": "^3.1.1"
  }
}
